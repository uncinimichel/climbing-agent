# Inventory: triples per named graph and who each graph is attributed to
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?graph ?source ?note WHERE {
  ?graph prov:wasAttributedTo ?src . ?src rdfs:label ?source .
  OPTIONAL { ?graph dcterms:description ?note }
} ORDER BY ?graph
