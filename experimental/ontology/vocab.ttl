    skos:inScheme vocab:commitment_grade ;
    skos:notation "VII" ;
    skos:prefLabel "VII"@en ;
    skos:topConceptOf vocab:commitment_grade ;
    climb:system "NCCS" .

<https://climbing-agent.dev/vocab/discipline/aid> a skos:Concept ;
