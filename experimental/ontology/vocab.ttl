    skos:inScheme vocab:discipline ;
    skos:notation "deepwatersolo" ;
    skos:prefLabel "deepwatersolo"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/ice> a skos:Concept ;
    skos:definition "Frozen falls/ice (WI grades)."@en ;
    skos:exactMatch <https://openbeta.io/schema/ClimbType/ice>,
        <https://wiki.openstreetmap.org/wiki/Tag:climbing:ice=yes> ;
    skos:inScheme vocab:discipline ;
    skos:notation "ice" ;
    skos:prefLabel "ice"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/mixed> a skos:Concept ;
    skos:definition "Rock + ice (M grades)."@en ;
    skos:exactMatch <https://openbeta.io/schema/ClimbType/mixed>,
        <https://wiki.openstreetmap.org/wiki/Tag:climbing:mixed=yes> ;
    skos:inScheme vocab:discipline ;
    skos:notation "mixed" ;
    skos:prefLabel "mixed"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/multi-pitch> a skos:Concept ;
    skos:definition "Multiple rope-lengths with belay stances (the platform's focus)."@en ;
    skos:exactMatch <https://wiki.openstreetmap.org/wiki/Tag:climbing:multipitch=yes> ;
    skos:inScheme vocab:discipline ;
    skos:notation "multi-pitch" ;
    skos:prefLabel "multi-pitch"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/scrambling> a skos:Concept ;
    skos:definition "Easy ungraded/Grade 1-3 terrain between walking and climbing — approach ridges, easy alpine crests."@en ;
    skos:inScheme vocab:discipline ;
    skos:notation "scrambling" ;
    skos:prefLabel "scrambling"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/single-pitch> a skos:Concept ;
    skos:definition "One rope-length."@en ;
    skos:inScheme vocab:discipline ;
    skos:notation "single-pitch" ;
    skos:prefLabel "single-pitch"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/snow> a skos:Concept ;
    skos:definition "Snow climbing."@en ;
    skos:exactMatch <https://openbeta.io/schema/ClimbType/snow> ;
    skos:inScheme vocab:discipline ;
    skos:notation "snow" ;
    skos:prefLabel "snow"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/sport> a skos:Concept ;
    skos:definition "Pre-placed bolts."@en ;
    skos:exactMatch <https://openbeta.io/schema/ClimbType/sport>,
        <https://wiki.openstreetmap.org/wiki/Tag:climbing:sport=yes> ;
    skos:inScheme vocab:discipline ;
    skos:notation "sport" ;
    skos:prefLabel "sport"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/tr> a skos:Concept ;
    skos:definition "Top-rope."@en ;
    skos:inScheme vocab:discipline ;
    skos:notation "tr" ;
    skos:prefLabel "tr"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/trad> a skos:Concept ;
    skos:definition "Leader-placed removable protection."@en ;
    skos:exactMatch <https://openbeta.io/schema/ClimbType/trad>,
        <https://wiki.openstreetmap.org/wiki/Tag:climbing:trad=yes> ;
    skos:inScheme vocab:discipline ;
    skos:notation "trad" ;
    skos:prefLabel "trad"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/discipline/via-ferrata> a skos:Concept ;
    skos:definition "Protected cabled route."@en ;
    skos:inScheme vocab:discipline ;
    skos:notation "via-ferrata" ;
    skos:prefLabel "via-ferrata"@en ;
    skos:topConceptOf vocab:discipline .

<https://climbing-agent.dev/vocab/feature/ar-te> a skos:Concept ;
    skos:definition "A narrow outward-pointing edge or prow — climbed on or beside it, exposed on both sides."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "arête" ;
    skos:prefLabel "arête"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/bulge> a skos:Concept ;
    skos:definition "A rounded steepening passed in a move or two — \"pull through the bulge\"; smaller than a roof."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "bulge" ;
    skos:prefLabel "bulge"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/chimney> a skos:Concept ;
    skos:definition "A crack wide enough to fit the whole body inside; climbed by back-and-footing."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "chimney" ;
    skos:prefLabel "chimney"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/corner> a skos:Concept ;
    skos:definition "An inside angle where two faces meet (dihedral / open book) — the opposite of an arête."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "corner" ;
    skos:prefLabel "corner"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/crack> a skos:Concept ;
    skos:definition "A fissure taking jams and natural protection — the classic trad medium."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "crack" ;
    skos:prefLabel "crack"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/face> a skos:Concept ;
    skos:definition "An open wall climbed on holds rather than a crack line."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "face" ;
    skos:prefLabel "face"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/flake> a skos:Concept ;
    skos:definition "A partly-detached sheet of rock forming an edge or crack behind it — check it is attached."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "flake" ;
    skos:prefLabel "flake"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/groove> a skos:Concept ;
    skos:definition "A shallow rounded corner or scoop, often climbed by bridging."@en ;
    skos:inScheme vocab:feature ;
    skos:notation "groove" ;
    skos:prefLabel "groove"@en ;
    skos:topConceptOf vocab:feature .

<https://climbing-agent.dev/vocab/feature/gully> a skos:Concept ;
    skos:definition "A wide mountain cleft or couloir line — common on UK/Irish mountain crags; often loose or wet."@en ;
