@prefix climb: <https://climbing-agent.dev/ontology/climb#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix thecrag: <https://www.thecrag.com/tag/> .
@prefix vocab: <https://climbing-agent.dev/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://climbing-agent.dev/vocab/approach_difficulty/flat-path> a skos:Concept ;
    skos:definition "Flat path, trainers fine."@en ;
    skos:inScheme vocab:approach_difficulty ;
    skos:notation "flat-path" ;
    skos:prefLabel "flat path"@en ;
    skos:topConceptOf vocab:approach_difficulty .

<https://climbing-agent.dev/vocab/approach_difficulty/scramble> a skos:Concept ;
    skos:definition "Hands-on scrambling to reach the base."@en ;
    skos:inScheme vocab:approach_difficulty ;
    skos:notation "scramble" ;
    skos:prefLabel "scramble"@en ;
    skos:topConceptOf vocab:approach_difficulty .

<https://climbing-agent.dev/vocab/approach_difficulty/steep-rough> a skos:Concept ;
    skos:definition "Steep or rough ground, no path in places."@en ;
    skos:inScheme vocab:approach_difficulty ;
    skos:notation "steep-rough" ;
    skos:prefLabel "steep rough"@en ;
    skos:topConceptOf vocab:approach_difficulty .

<https://climbing-agent.dev/vocab/approach_difficulty/technical> a skos:Concept ;
    skos:definition "Technical approach: abseil, Tyrolean, boat or tidal timing."@en ;
    skos:inScheme vocab:approach_difficulty ;
    skos:notation "technical" ;
    skos:prefLabel "technical"@en ;
    skos:topConceptOf vocab:approach_difficulty .

<https://climbing-agent.dev/vocab/approach_difficulty/uphill-walk> a skos:Concept ;
    skos:definition "Uphill walk on a path."@en ;
    skos:inScheme vocab:approach_difficulty ;
    skos:notation "uphill-walk" ;
    skos:prefLabel "uphill walk"@en ;
    skos:topConceptOf vocab:approach_difficulty .

<https://climbing-agent.dev/vocab/ascent_style/aid> a skos:Concept ;
    skos:definition "Weighting gear to make upward progress."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "aid" ;
    skos:prefLabel "aid"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/clean> a skos:Concept ;
    skos:definition "Modifier: no falls, no resting on gear."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "clean" ;
    skos:prefLabel "clean"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier true .

<https://climbing-agent.dev/vocab/ascent_style/dog> a skos:Concept ;
    skos:definition "Modifier: worked the route resting on gear (hangdog)."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "dog" ;
    skos:prefLabel "dog"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier true .

<https://climbing-agent.dev/vocab/ascent_style/flash> a skos:Concept ;
    skos:definition "Lead first try, clean, with prior beta."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "flash" ;
    skos:prefLabel "flash"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/groundup> a skos:Concept ;
    skos:definition "Attempted from the ground up, no top-rope rehearsal."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "groundup" ;
    skos:prefLabel "groundup"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/headpoint> a skos:Concept ;
    skos:definition "Trad: clean lead after top-rope practice."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "headpoint" ;
    skos:prefLabel "headpoint"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/onsight> a skos:Concept ;
    skos:definition "Lead first try, clean, no prior beta."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "onsight" ;
    skos:prefLabel "onsight"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/pinkpoint> a skos:Concept ;
    skos:definition "Redpoint with gear pre-placed (now usually folded into redpoint)."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "pinkpoint" ;
    skos:prefLabel "pinkpoint"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/redpoint> a skos:Concept ;
    skos:definition "Clean lead after rehearsal."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "redpoint" ;
    skos:prefLabel "redpoint"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/second> a skos:Concept ;
    skos:definition "Climbed after the leader, roped from above."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "second" ;
    skos:prefLabel "second"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/solo> a skos:Concept ;
    skos:definition "Climbed with no rope."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "solo" ;
    skos:prefLabel "solo"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/ascent_style/toprope> a skos:Concept ;
    skos:definition "Climbed on a rope anchored above."@en ;
    skos:inScheme vocab:ascent_style ;
    skos:notation "toprope" ;
    skos:prefLabel "toprope"@en ;
    skos:topConceptOf vocab:ascent_style ;
    climb:is_modifier false .

<https://climbing-agent.dev/vocab/character/crimpy> a skos:Concept ;
    skos:definition "Specifically small-edge crimping."@en ;
    skos:inScheme vocab:character ;
    skos:notation "crimpy" ;
    skos:prefLabel "crimpy"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/delicate> a skos:Concept ;
    skos:definition "Balance/friction climbing; precision under little security."@en ;
    skos:inScheme vocab:character ;
    skos:notation "delicate" ;
    skos:prefLabel "delicate"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/exposed> a skos:Concept ;
    skos:definition "Big-air positions beyond what the protection grade captures."@en ;
    skos:inScheme vocab:character ;
    skos:notation "exposed" ;
    skos:prefLabel "exposed"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/fingery> a skos:Concept ;
    skos:definition "Significant small holds on the hard sections (Rockfax \"f\")."@en ;
    skos:inScheme vocab:character ;
    skos:notation "fingery" ;
    skos:prefLabel "fingery"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/fluttery> a skos:Concept ;
    skos:definition "Bold, heady climbing — spaced or marginal gear above hard moves (the Rockfax heart symbol; UK climbers say \"bold\")."@en ;
    skos:inScheme vocab:character ;
    skos:notation "fluttery" ;
    skos:prefLabel "fluttery"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/powerful> a skos:Concept ;
    skos:definition "Demands strength on steep ground (Rockfax \"p\")."@en ;
    skos:inScheme vocab:character ;
    skos:notation "powerful" ;
    skos:prefLabel "powerful"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/pumpy> a skos:Concept ;
    skos:definition "Steep endurance climbing — the pump is the crux."@en ;
    skos:inScheme vocab:character ;
    skos:notation "pumpy" ;
    skos:prefLabel "pumpy"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/reachy> a skos:Concept ;
    skos:definition "Move spans favour reach; height-dependent."@en ;
    skos:inScheme vocab:character ;
    skos:notation "reachy" ;
    skos:prefLabel "reachy"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/rounded> a skos:Concept ;
    skos:definition "Rounded, sloping holds and breaks (gritstone-style) — Rockfax symbol; friction- and humidity-sensitive."@en ;
    skos:inScheme vocab:character ;
    skos:notation "rounded" ;
    skos:prefLabel "rounded"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/sustained> a skos:Concept ;
    skos:definition "Lots of hard moves with little respite (Rockfax \"s\")."@en ;
    skos:inScheme vocab:character ;
    skos:notation "sustained" ;
    skos:prefLabel "sustained"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/character/technical> a skos:Concept ;
    skos:definition "Intricate movement; body position over pulling."@en ;
    skos:inScheme vocab:character ;
    skos:notation "technical" ;
    skos:prefLabel "technical"@en ;
    skos:topConceptOf vocab:character .

<https://climbing-agent.dev/vocab/commitment_grade/ABO> a skos:Concept ;
